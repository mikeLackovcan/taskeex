rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and change only their own tasks.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
